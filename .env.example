# ========================================
# NekoCurrencies Bot - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# Скопируйте этот файл в .env и заполните своими значениями

# ========================================
# REQUIRED / ОБЯЗАТЕЛЬНЫЕ
# ========================================

# Your Telegram bot token (get it from @BotFather)
# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ========================================
# OPTIONAL / ОПЦИОНАЛЬНЫЕ
# ========================================

# CurrencyFreaks API key — fallback for crypto (optional)
# Ключ CurrencyFreaks — фоллбек для крипты (опционально)
CURRENCY_FREAKS_API_KEY=

# ExchangeRate-API key — reserve source (optional)
# Ключ ExchangeRate-API — резервный источник (опционально)
EXCHANGE_RATE_API_KEY=

# Admin user IDs, comma-separated (bypass rate limit)
# ID администраторов через запятую (вне лимита запросов)
ADMIN_IDS=

# ========================================
# BOT SETTINGS / НАСТРОЙКИ БОТА
# ========================================

# Minimum interval between requests from one user, seconds
# Минимальный интервал между запросами одного пользователя (секунды)
RATE_LIMIT_PERIOD=1.0

# Currency rates cache lifetime, seconds (default: 600 = 10 minutes)
# Время жизни кэша курсов, секунды (по умолчанию: 600 = 10 минут)
CACHE_LIFETIME=600

# Logging: DEBUG | INFO | WARNING | ERROR
# Логирование: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
# Путь к файлу логов
LOG_FILE=logs/bot.log

# SQLite database path
# Путь к базе данных SQLite
DATABASE_FILE=data/users.db

# Bot version shown by /version
# Версия бота для /version
BOT_VERSION=1.2.0
